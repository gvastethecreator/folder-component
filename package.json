{
  "name": "folder-component",
  "version": "0.1.0",
  "private": true,
  "description": "A five-engine playground for interactive animated folder components.",
  "homepage": "https://gvastethecreator.github.io/folder-component/",
  "bugs": {
    "url": "https://github.com/gvastethecreator/folder-component/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/folder-component.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host localhost",
    "build": "vite build",
    "build:pages": "vite build --base=/folder-component/",
    "preview": "vite preview --host localhost",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:coverage": "vitest run src --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "deps:check": "pnpm outdated --format json && pnpm peers check && pnpm audit",
    "clean": "tsx scripts/clean.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@tabler/icons-react": "^3.46.0",
    "animejs": "^4.5.0",
    "gsap": "3.15.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.21.0"
}
